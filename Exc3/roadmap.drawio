          <mxGeometry y="320" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6bCKN2paZI4ugrq-OCFl-11" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Квартал 1&lt;/h1&gt;&lt;p&gt;- Задеплоен&amp;nbsp;Apache Superset и подключен DWH&lt;/p&gt;&lt;p&gt;- Задеплоен&amp;nbsp;DataHub&lt;/p&gt;&lt;p&gt;- Создан шаблон для поднятия Airflow и&lt;/p&gt;&lt;p&gt;- Данные финтеха мигрированы в базы финтех компании, DWH все еще обновляется с помощью&amp;nbsp;Apache Camel&amp;nbsp;&lt;/p&gt;&lt;p&gt;- Данные ии-сервисов мигрированы в базы ИИ компании, DWH все еще обновляется с помощью&amp;nbsp;Apache Camel&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p&gt;- Данные МИС мигрированы в базы компанииклиники , DWH все еще обновляется с помощью&amp;nbsp;Apache Camel&amp;nbsp;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry y="440" width="200" height="480" as="geometry" />
        </mxCell>
        <mxCell id="6bCKN2paZI4ugrq-OCFl-12" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Квартал 2&lt;/h1&gt;&lt;p&gt;- Аналитики обучены пользоваться&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Apache Superset&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- Созданы требования к датасетам&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;-&amp;nbsp; DWH обновляется только с помощью&amp;nbsp;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Airflow и&amp;nbsp;Apache NiFi из различных компаний&lt;/span&gt;&lt;/p&gt;&lt;p&gt;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Apache Camel удален&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="210" y="440" width="210" height="480" as="geometry" />
        </mxCell>
        <mxCell id="6bCKN2paZI4ugrq-OCFl-13" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Квартал 3&lt;/h1&gt;&lt;p&gt;- Команды создали дата-продукты и подключили их к&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Superset&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;и&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DataHub&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="430" y="440" width="200" height="520" as="geometry" />
        </mxCell>
        <mxCell id="6bCKN2paZI4ugrq-OCFl-14" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Квартал 4&lt;/h1&gt;&lt;p&gt;- Аналитики пользуются только&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Apache Superset&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;и&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DataHub&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Microsoft SQL и Power BI удалены&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="640" y="440" width="200" height="560" as="geometry" />
        </mxCell>
        <mxCell id="6bCKN2paZI4ugrq-OCFl-15" value="Деплой SuperSet&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; text-align: start; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%D0%A8%D0%B0%D0%B1%D0%BB%D0%BE%D0%BD%20%D1%80%D0%B0%D0%B7%D0%B2%D0%B5%D1%80%D1%82%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D1%8F%20ETL%22%20style%3D%22rounded%3D1%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%22120%22%20y%3D%2280%22%20width%3D%22120%22%20height%3D%2230%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
